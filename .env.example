# 默认 DeepSeek 官方服务；公开示例不包含密钥，未配置时使用规则演示
FF_PLANNER_MODE=rules
FF_PORT=8765
FF_MODEL_BASE_URL=https://api.deepseek.com
FF_MODEL_NAME=deepseek-flash
FF_MODEL_API_KEY=
FF_MODEL_REASONING_EFFORT=medium
# 可选受限计算生成，默认关闭
FF_CODEGEN_MODE=off
FF_CODEGEN_ROLE=provider
FF_COORD_MODEL_BASE_URL=
FF_COORD_MODEL_NAME=
FF_COORD_MODEL_API_KEY=
FF_COORD_MODEL_REASONING_EFFORT=medium
FF_RUNTIME_PROXY_URL=

# 只在自己电脑上的演示环境开启首页设置保存；关闭后入口只读
FF_ALLOW_MODEL_SETTINGS=1
