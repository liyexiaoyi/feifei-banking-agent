(module
  (func $run (export "run") (param $a i64) (param $b i64) (param $c i64) (result i64)
    (local $mx i64)
    (local $mn i64)
    ;; max of a, b, c (signed)
    (local.set $mx (select (local.get $a) (local.get $b) (i64.gt_s (local.get $a) (local.get $b))))
    (local.set $mx (select (local.get $mx) (local.get $c) (i64.gt_s (local.get $mx) (local.get $c))))
    ;; min of a, b, c (signed)
    (local.set $mn (select (local.get $a) (local.get $b) (i64.lt_s (local.get $a) (local.get $b))))
    (local.set $mn (select (local.get $mn) (local.get $c) (i64.lt_s (local.get $mn) (local.get $c))))
    ;; range = max - min (wraps on overflow)
    (i64.sub (local.get $mx) (local.get $mn))
  )
)